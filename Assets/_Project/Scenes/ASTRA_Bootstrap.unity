--- !u!114 &999610308
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 999610305}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d58b9604446ad634594be730a13638ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Astra.TutorialManager
  activities:
  - titleKey: tutorial.meet.title
    bodyKey: tutorial.meet.body
    titleFallback: MEET YOUR ASTRONAUT
    bodyFallback: This is your astronaut. ASTRO is here beside you. Take your time; you can try anything again.
    voiceClip: meet
  - titleKey: tutorial.move.title
    bodyKey: tutorial.move.body
    titleFallback: LEARN TO MOVE
    bodyFallback: Press W, A, S or D to walk. Arrow keys work too. Click the ground to walk there.
    voiceClip: move
  - titleKey: tutorial.look.title
    bodyKey: tutorial.look.body
    titleFallback: LOOK AROUND
    bodyFallback: Hold the right mouse button and move the mouse to look around.
    voiceClip: look
  - titleKey: tutorial.interact.title
    bodyKey: tutorial.interact.body
    titleFallback: TRY AN INTERACTION
    bodyFallback: Walk to the glowing practice panel. When the arrow points down, press E. Nothing can go wrong here.
    voiceClip: interact
  - titleKey: tutorial.equipment.title
    bodyKey: tutorial.equipment.body
    titleFallback: MEET THE EQUIPMENT
    bodyFallback: Tap an equipment picture. ASTRO will tell you what it does.
    voiceClip: equipment
  - titleKey: tutorial.task.title
    bodyKey: tutorial.task.body
    titleFallback: POWER UP A PRACTICE PANEL
    bodyFallback: Follow the arrow to the small practice solar panel and press E. Watch it light up!
    voiceClip: practice
--- !u!114 &999610309
